cabal-version: 3.0
name: microcfta-generator
version: 0.1.0.0
synopsis: Generators, ranking, and QuickCheck integration for constrained tree automata
description:
  Ranked enumeration, random generation, shrinking, and QuickCheck
  integration for the automata of microcfta: ordinary, equality-constrained,
  and refinement-constrained.

homepage: https://github.com/Tritlo/microecta/tree/main/microcfta-generator#readme
bug-reports: https://github.com/Tritlo/microecta/issues
category: Testing
author: Matthias Pall Gissurarson
maintainer: mpg@mpg.is
copyright: 2026 Matthias Pall Gissurarson
license: BSD-3-Clause
license-file: LICENSE
build-type: Simple
tested-with: ghc ==9.14.1
extra-doc-files:
  CHANGELOG.md
  README.md

source-repository head
  type: git
  location: https://github.com/Tritlo/microecta.git
  subdir: microcfta-generator

common warnings
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wpartial-fields
    -Wredundant-constraints
    -Wno-pattern-namespace-specifier

common extensions
  default-language: Haskell2010
  default-extensions:
    BangPatterns
    ConstraintKinds
    DataKinds
    DefaultSignatures
    DeriveDataTypeable
    DeriveGeneric
    EmptyDataDecls
    ExistentialQuantification
    FlexibleContexts
    FlexibleInstances
    FunctionalDependencies
    GADTs
    GeneralizedNewtypeDeriving
    KindSignatures
    LambdaCase
    MultiParamTypeClasses
    NamedFieldPuns
    PatternGuards
    RankNTypes
    ScopedTypeVariables
    StandaloneDeriving
    TupleSections
    TypeApplications
    TypeFamilies
    TypeOperators
    ViewPatterns

common plain-extensions
  default-language: Haskell2010
  default-extensions:
    BangPatterns
    FlexibleContexts
    GADTs
    NamedFieldPuns
    RankNTypes
    ScopedTypeVariables

library
  import: warnings, extensions
  hs-source-dirs: src
  exposed-modules:
    Data.CFTA.Gen
    Data.CFTA.Gen.Do
    Data.CFTA.Gen.Equality
    Data.CFTA.Gen.Equality.Do
    Data.CFTA.Gen.Equality.Internal.Symbolic
    Data.CFTA.Gen.Equality.QuickCheck
    Data.CFTA.Gen.Equality.Sig
    Data.CFTA.Gen.Example.TypedExpressionLanguage
    Data.CFTA.Gen.Internal.Automaton
    Data.CFTA.Gen.Internal.Shrink
    Data.CFTA.Gen.QuickCheck
    Data.CFTA.Gen.Refinement
    Data.CFTA.Gen.Refinement.Do
    Data.CFTA.Gen.Refinement.QuickCheck
    Data.CFTA.Ranked
    Data.CFTA.Ranked.Internal
    Data.CFTA.Ranked.Internal.Decoder
    Data.CFTA.Ranked.Internal.Sampler
    Data.CFTA.Ranked.Internal.Shrink
    Data.CFTA.Ranked.Internal.Size
    Data.CFTA.Ranked.QuickCheck

  other-modules:
    Data.CFTA.Gen.Equality.Internal
    Data.CFTA.Gen.Equality.Internal.Automaton
    Data.CFTA.Gen.Equality.Internal.Bucket
    Data.CFTA.Gen.Equality.Internal.Chain
    Data.CFTA.Gen.Equality.Internal.Error
    Data.CFTA.Gen.Equality.Internal.Grouped
    Data.CFTA.Gen.Equality.Internal.Inspect
    Data.CFTA.Gen.Equality.Internal.Inspection
    Data.CFTA.Gen.Equality.Internal.Join
    Data.CFTA.Gen.Equality.Internal.Recursion
    Data.CFTA.Gen.Equality.Internal.Recursive
    Data.CFTA.Gen.Equality.Internal.Static
    Data.CFTA.Gen.Equality.Internal.Support
    Data.CFTA.Gen.Equality.Internal.Types
    Data.CFTA.Gen.Refinement.Internal.AutomatonCompile
    Data.CFTA.Gen.Refinement.Internal.AutomatonSource
    Data.CFTA.Gen.Refinement.Internal.Bounded
    Data.CFTA.Gen.Refinement.Internal.Compile
    Data.CFTA.Gen.Refinement.Internal.Error
    Data.CFTA.Gen.Refinement.Internal.IndexedGroup
    Data.CFTA.Gen.Refinement.Internal.Recipe
    Data.CFTA.Gen.Refinement.Internal.Relational
    Data.CFTA.Gen.Refinement.Internal.Replay
    Data.CFTA.Gen.Refinement.Internal.ShrinkSearch
    Data.CFTA.Gen.Refinement.Internal.SourceIndex
    Data.CFTA.Gen.Refinement.Internal.Surface
    Data.CFTA.Gen.Refinement.Internal.Types
    Data.CFTA.Gen.Refinement.Internal.Witness

  build-depends:
    array >=0.5 && <0.6,
    base >=4.22 && <4.23,
    containers >=0.8 && <0.9,
    hashable >=1.5 && <1.6,
    microcfta >=0.1.0.0 && <0.2,
    mtl >=2.3 && <2.4,
    QuickCheck >=2.14 && <2.19,
    text >=2.1 && <2.2,

executable cfta-pairs
  import: warnings
  main-is: FinitePairs.hs
  hs-source-dirs: examples
  default-language: Haskell2010
  build-depends:
    base >=4.22 && <4.23,
    containers >=0.8 && <0.9,
    microcfta >=0.1.0.0 && <0.2,
    microcfta-generator,
    QuickCheck >=2.14 && <2.19,

executable cfta-finite-languages
  import: warnings
  main-is: FiniteLanguages.hs
  hs-source-dirs: examples
  default-language: Haskell2010
  build-depends:
    base >=4.22 && <4.23,
    microcfta >=0.1.0.0 && <0.2,
    microcfta-generator,
    QuickCheck >=2.14 && <2.19,

executable cfta-draw-typed-expressions
  import: warnings
  main-is: DrawTypedExpressions.hs
  hs-source-dirs: examples
  default-language: Haskell2010
  build-depends:
    base >=4.22 && <4.23,
    containers >=0.8 && <0.9,
    microcfta >=0.1.0.0 && <0.2,
    microcfta-generator,
    text >=2.1 && <2.2,

executable cfta-liquid-pairs
  import: warnings
  main-is: LiquidPairs.hs
  hs-source-dirs: examples
  default-language: Haskell2010
  default-extensions: OverloadedStrings
  build-depends:
    base >=4.22 && <4.23,
    liquid-fixpoint >=0.9.6.3.7 && <0.10,
    microcfta >=0.1.0.0 && <0.2,
    microcfta-generator,
    QuickCheck >=2.14 && <2.19,

executable cfta-safe-division
  import: warnings
  main-is: SafeDivision.hs
  hs-source-dirs: examples
  default-language: Haskell2010
  build-depends:
    base >=4.22 && <4.23,
    microcfta >=0.1.0.0 && <0.2,
    microcfta-generator,
    QuickCheck >=2.14 && <2.19,

executable cfta-automaton-interop
  import: warnings
  main-is: AutomatonInterop.hs
  hs-source-dirs: examples
  default-language: Haskell2010
  build-depends:
    base >=4.22 && <4.23,
    microcfta >=0.1.0.0 && <0.2,
    microcfta-generator,
    QuickCheck >=2.14 && <2.19,

test-suite plain-tests
  import: warnings, plain-extensions
  type: exitcode-stdio-1.0
  main-is: PlainSpec.hs
  hs-source-dirs:
    common
    test

  other-modules:
    Data.CFTA.Gen.UntypedExpressionLanguage
    Data.CFTA.GenSpec
    Data.CFTA.RankedSpec

  build-depends:
    base >=4.22 && <4.23,
    containers >=0.8 && <0.9,
    hspec >=2.11 && <2.12,
    microcfta >=0.1.0.0 && <0.2,
    microcfta-generator,
    QuickCheck >=2.14 && <2.19,

test-suite equality-tests
  import: warnings, extensions
  type: exitcode-stdio-1.0
  main-is: EqualitySpec.hs
  hs-source-dirs: test
  ghc-options:
    -threaded
    -rtsopts
    -with-rtsopts=-N

  other-modules:
    Data.CFTA.Gen.Equality.DatatypeGenSpec
    Data.CFTA.Gen.Equality.GenSpec
    Data.CFTA.Gen.Equality.IFCExpressionGenSpec
    Data.CFTA.Gen.Equality.IFCExpressionLanguage
    Data.CFTA.Gen.Equality.RankDecodingSpec
    Data.CFTA.Gen.Equality.RecursiveGenSpec
    Data.CFTA.Gen.Equality.TestSupport
    Data.CFTA.Gen.Equality.TypedExpressionGenSpec

  build-depends:
    base >=4.22 && <4.23,
    containers >=0.8 && <0.9,
    hspec >=2.11 && <2.12,
    microcfta >=0.1.0.0 && <0.2,
    microcfta-generator,
    QuickCheck >=2.14 && <2.19,
    text >=2.1 && <2.2,

test-suite refinement-tests
  import: warnings
  type: exitcode-stdio-1.0
  main-is: RefinementSpec.hs
  hs-source-dirs:
    common
    test

  default-language: Haskell2010
  default-extensions:
    ApplicativeDo
    NamedFieldPuns
    OverloadedStrings
    PatternSynonyms
    QualifiedDo

  other-modules:
    Data.CFTA.Gen.Refinement.BoundedGeneratorSpec
    Data.CFTA.Gen.Refinement.DependentApplicationSpec
    Data.CFTA.Gen.Refinement.ExampleSupport
    Data.CFTA.Gen.Refinement.OpaquePoolSpec
    Data.CFTA.Gen.Refinement.PreconditionTypedExpressionSpec
    Data.CFTA.Gen.Refinement.QuickCheckSyntaxSpec
    Data.CFTA.Gen.Refinement.RecursiveGeneratorSpec
    Data.CFTA.Gen.Refinement.SafeBufferLanguage
    Data.CFTA.Gen.Refinement.SafeBufferSpec
    Data.CFTA.Gen.Refinement.SimilarityMinimizationSpec
    Data.CFTA.Gen.Refinement.SizedVectorLanguage
    Data.CFTA.Gen.Refinement.SizedVectorSpec
    Data.CFTA.Gen.Refinement.StateMachineTraceLanguage
    Data.CFTA.Gen.Refinement.StateMachineTraceSpec
    Data.CFTA.Gen.Refinement.SubsumptionTypedExpressionSpec
    Data.CFTA.Gen.Refinement.TestSupport
    Data.CFTA.Gen.Refinement.TypedExpressionLanguage

  build-depends:
    base >=4.22 && <4.23,
    containers >=0.8 && <0.9,
    directory >=1.3 && <1.4,
    hspec >=2.11 && <2.12,
    liquid-fixpoint >=0.9.6.3.7 && <0.10,
    microcfta >=0.1.0.0 && <0.2,
    microcfta-generator,
    QuickCheck >=2.14 && <2.19,

benchmark untyped-expression-speed
  import: warnings, plain-extensions
  type: exitcode-stdio-1.0
  main-is: UntypedExpressionSpeed.hs
  hs-source-dirs:
    benchmarks
    common

  ghc-options:
    -rtsopts
    -with-rtsopts=-T

  other-modules:
    Data.CFTA.Gen.UntypedExpressionLanguage
    GeneratorSpeedHarness

  build-depends:
    base >=4.22 && <4.23,
    containers >=0.8 && <0.9,
    microcfta >=0.1.0.0 && <0.2,
    microcfta-generator,
    process >=1.6 && <1.7,
    QuickCheck >=2.14 && <2.19,
    random >=1.2 && <1.4,

benchmark typed-expression-speed
  import: warnings, extensions
  type: exitcode-stdio-1.0
  main-is: TypedExpressionSpeed.hs
  hs-source-dirs: benchmarks
  ghc-options:
    -rtsopts
    -with-rtsopts=-T

  other-modules: GeneratorSpeedHarness
  build-depends:
    base >=4.22 && <4.23,
    microcfta-generator,
    process >=1.6 && <1.7,
    QuickCheck >=2.14 && <2.19,
    random >=1.2 && <1.4,

benchmark state-machine-trace-speed
  import: warnings
  type: exitcode-stdio-1.0
  main-is: StateMachineTraceSpeed.hs
  hs-source-dirs:
    benchmarks
    common

  default-language: Haskell2010
  default-extensions: NamedFieldPuns
  ghc-options:
    -rtsopts
    -with-rtsopts=-T

  other-modules:
    Data.CFTA.Gen.Refinement.ExampleSupport
    Data.CFTA.Gen.Refinement.StateMachineTraceLanguage
    GeneratorSpeedHarness

  build-depends:
    base >=4.22 && <4.23,
    containers >=0.8 && <0.9,
    liquid-fixpoint >=0.9.6.3.7 && <0.10,
    microcfta >=0.1.0.0 && <0.2,
    microcfta-generator,
    process >=1.6 && <1.7,
    QuickCheck >=2.14 && <2.19,
    random >=1.2 && <1.4,

benchmark typed-expression-constraint-cost
  import: warnings
  type: exitcode-stdio-1.0
  main-is: TypedExpressionConstraintCost.hs
  hs-source-dirs:
    benchmarks
    common

  default-language: Haskell2010
  default-extensions: NamedFieldPuns
  ghc-options:
    -rtsopts
    -with-rtsopts=-T

  other-modules:
    Data.CFTA.Gen.Refinement.EqualityTypedExpressionLanguage
    GeneratorSpeedHarness

  build-depends:
    base >=4.22 && <4.23,
    containers >=0.8 && <0.9,
    liquid-fixpoint >=0.9.6.3.7 && <0.10,
    microcfta >=0.1.0.0 && <0.2,
    microcfta-generator,
    process >=1.6 && <1.7,
    QuickCheck >=2.14 && <2.19,
    random >=1.2 && <1.4,
