cabal-version: 3.0
name: microlta-generator
version: 0.1.0.0
synopsis: Finite generators backed by liquid tree automata
description:
  Qualified-do LTA generators with frozen pools, semantic pruning and
  shrinking, similarity minimisation, bounded recursion, and exact replay.

homepage: https://github.com/Tritlo/microecta#readme
bug-reports: https://github.com/Tritlo/microecta/issues
category: Testing
author: Matthias Pall Gissurarson
maintainer: mpg@mpg.is
copyright: 2026 Matthias Pall Gissurarson
license: BSD-3-Clause
license-file: LICENSE
build-type: Simple
tested-with: ghc ==9.12.2 || ==9.14.1
extra-doc-files: README.md

source-repository head
  type: git
  location: https://github.com/Tritlo/microecta.git
  subdir: microlta-generator

common warnings
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wpartial-fields
    -Wredundant-constraints

  if impl(ghc >=9.14)
    ghc-options: -Wno-pattern-namespace-specifier

library
  import: warnings
  hs-source-dirs: src
  default-language: Haskell2010
  default-extensions:
    NamedFieldPuns

  exposed-modules:
    Data.LTA.Gen
    Data.LTA.Gen.Do
    Data.LTA.Gen.QuickCheck

  build-depends:
    QuickCheck >=2.14 && <2.19,
    base >=4.21 && <5,
    containers >=0.7 && <0.9,
    microecta-generator >=0.1 && <0.2,
    microlta >=0.1 && <0.2,

executable liquid-pairs
  import: warnings
  main-is: LiquidPairs.hs
  hs-source-dirs: examples
  default-language: Haskell2010
  default-extensions: OverloadedStrings
  build-depends:
    QuickCheck >=2.14 && <2.19,
    base >=4.21 && <5,
    liquid-fixpoint >=0.9.6.3.7 && <0.10,
    microecta-generator >=0.1 && <0.2,
    microlta >=0.1 && <0.2,
    microlta-generator,

test-suite unit-tests
  import: warnings
  type: exitcode-stdio-1.0
  main-is: Spec.hs
  hs-source-dirs:
    common
    test

  default-language: Haskell2010
  default-extensions:
    ApplicativeDo
    NamedFieldPuns
    OverloadedStrings
    PatternSynonyms
    QualifiedDo

  other-modules:
    Data.LTA.DependentApplicationSpec
    Data.LTA.PreconditionTypedExpressionSpec
    Data.LTA.QuickCheckSyntaxSpec
    Data.LTA.RecursiveGeneratorSpec
    Data.LTA.SimilarityMinimizationSpec
    Data.LTA.SubsumptionTypedExpressionSpec
    Data.LTA.TypedExpressionLanguage

  build-depends:
    QuickCheck >=2.14 && <2.19,
    base >=4.21 && <5,
    hspec >=2.11 && <2.12,
    liquid-fixpoint >=0.9.6.3.7 && <0.10,
    microecta >=0.2.0.0 && <0.3,
    microlta >=0.1 && <0.2,
    microlta-generator,
