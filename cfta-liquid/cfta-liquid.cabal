cabal-version: 3.0
name: cfta-liquid
version: 0.1.0.0
synopsis: Liquid tree automata on the interned engine of cfta
description:
  Liquid tree automata (LTA) after Mishra and Jagannathan: transitions with
  refinements and guards over child positions, recognition, pruning,
  similarity, minimization, the bounded denotation, and an exact
  lattice entailment for bounded linear integer formulas. Implications go
  through the Entailment port; cfta-z3 has the Z3 adapter.

homepage: https://github.com/Tritlo/microecta/tree/main/cfta-liquid#readme
bug-reports: https://github.com/Tritlo/microecta/issues
category: Data
author: Jimmy Koppel, Matthias Pall Gissurarson
maintainer: mpg@mpg.is
copyright: 2021-2024 Jimmy Koppel, 2026 Matthias Pall Gissurarson
license: BSD-3-Clause
license-file: LICENSE
build-type: Simple
tested-with: ghc ==9.14.1
extra-doc-files:
  CHANGELOG.md

source-repository head
  type: git
  location: https://github.com/Tritlo/microecta.git
  subdir: cfta-liquid

common warnings
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wpartial-fields
    -Wredundant-constraints
    -Wno-pattern-namespace-specifier

common extensions
  default-language: Haskell2010
  default-extensions:
    BangPatterns
    ConstraintKinds
    DataKinds
    DefaultSignatures
    DeriveDataTypeable
    DeriveGeneric
    EmptyDataDecls
    ExistentialQuantification
    FlexibleContexts
    FlexibleInstances
    FunctionalDependencies
    GADTs
    GeneralizedNewtypeDeriving
    KindSignatures
    LambdaCase
    MultiParamTypeClasses
    MultiWayIf
    NamedFieldPuns
    PatternGuards
    PatternSynonyms
    RankNTypes
    ScopedTypeVariables
    StandaloneDeriving
    TupleSections
    TypeApplications
    TypeFamilies
    TypeOperators
    ViewPatterns

library
  import: warnings, extensions
  hs-source-dirs: src
  exposed-modules:
    Data.CFTA.Refinement
    Data.CFTA.Refinement.Automaton
    Data.CFTA.Refinement.Denotation
    Data.CFTA.Refinement.Evaluate
    Data.CFTA.Refinement.Guard
    Data.CFTA.Refinement.Lattice
    Data.CFTA.Refinement.Minimize
    Data.CFTA.Refinement.Prune
    Data.CFTA.Refinement.Verdict

  build-depends:
    base >=4.22 && <4.23,
    cfta ==0.1.0.0,
    cfta-base ==0.1.0.0,
    containers >=0.8 && <0.9,
    mtl >=2.3 && <2.4,
    text >=2.1 && <2.2,

test-suite liquid-tests
  import: warnings, extensions
  type: exitcode-stdio-1.0
  main-is: Spec.hs
  hs-source-dirs: test
  ghc-options:
    -threaded
    -rtsopts
    -with-rtsopts=-N

  other-modules:
    Data.CFTA.Refinement.GuardSpec
    Data.CFTA.Refinement.MinimizeSpec
    Data.CFTA.Refinement.PruneSpec
    Data.CFTA.Refinement.RecognitionSpec
    Data.CFTA.Refinement.RecursiveSpec
    Data.CFTA.Refinement.RefinementRelationSpec
    Data.CFTA.Refinement.SimpleSpec
    Data.CFTA.Refinement.SubstitutionSpec
    Data.CFTA.Refinement.SyntaxSpec
    Data.CFTA.Refinement.TestSupport

  build-depends:
    base,
    cfta,
    cfta-base,
    cfta-liquid,
    containers >=0.8 && <0.9,
    hspec >=2.11 && <2.12,
    QuickCheck >=2.14 && <2.19,

benchmark cross-layer-speed
  import: warnings, extensions
  type: exitcode-stdio-1.0
  main-is: CrossLayerSpeed.hs
  hs-source-dirs: benchmarks
  ghc-options: -rtsopts
  build-depends:
    base >=4.22 && <4.23,
    cfta,
    cfta-base,
    cfta-liquid,
    containers >=0.8 && <0.9,
    text >=2.1 && <2.2,
