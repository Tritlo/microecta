cabal-version: 3.0
name: microcfta
version: 0.1.0.0
synopsis: Shared interned tree automata and finite-state graphs
description:
  Constraint-parameterized interned tree automata with shared recursive
  operations, ordinary first-order trees, and checked finite-state graphs.

homepage: https://github.com/Tritlo/microecta/tree/main/microcfta#readme
bug-reports: https://github.com/Tritlo/microecta/issues
category: Data
author: Jimmy Koppel, Matthias Pall Gissurarson
maintainer: mpg@mpg.is
copyright: 2021-2024 Jimmy Koppel, 2026 Matthias Pall Gissurarson
license: BSD-3-Clause
license-file: LICENSE
build-type: Simple
tested-with: ghc ==9.14.1
extra-doc-files:
  CHANGELOG.md
  README.md

source-repository head
  type: git
  location: https://github.com/Tritlo/microecta.git
  subdir: microcfta

common warnings
  default-language: Haskell2010
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wpartial-fields
    -Wredundant-constraints
    -Wno-pattern-namespace-specifier

library
  import: warnings
  hs-source-dirs: src
  default-extensions:
    BangPatterns
    ConstraintKinds
    FlexibleContexts
    FlexibleInstances
    GADTs
    LambdaCase
    MultiWayIf
    NamedFieldPuns
    PatternSynonyms
    RankNTypes
    ScopedTypeVariables
    StandaloneDeriving
    TypeApplications
    TypeFamilies
    TypeOperators
    ViewPatterns

  other-modules: Data.CFTA.Internal.Tree
  exposed-modules:
    Data.CFTA
    Data.CFTA.Constraint
    Data.CFTA.Generic
    Data.CFTA.Interned
    Data.CFTA.Interned.Cache
    Data.CFTA.Interned.Memo
    Data.CFTA.Interned.Operations
    Data.CFTA.Interned.Type
    Data.CFTA.Path
    Data.CFTA.Symbol
    Data.CFTA.Template

  build-depends:
    base >=4.22 && <4.23,
    containers >=0.8 && <0.9,
    hashable >=1.5 && <1.6,
    intern >=0.9 && <0.10,
    mtl >=2.3 && <2.4,
    text >=2.1 && <2.2,
    unordered-containers >=0.2 && <0.3,

test-suite unit-tests
  import: warnings
  type: exitcode-stdio-1.0
  main-is: Spec.hs
  hs-source-dirs: test
  other-modules: Data.CFTASpec
  build-depends:
    base >=4.22 && <4.23,
    containers >=0.8 && <0.9,
    hashable >=1.5 && <1.6,
    hspec >=2.11 && <2.12,
    microcfta,

benchmark enumeration-speed
  import: warnings
  type: exitcode-stdio-1.0
  main-is: EnumerationSpeed.hs
  hs-source-dirs: benchmarks
  default-extensions:
    BangPatterns
    NamedFieldPuns

  build-depends:
    base >=4.22 && <4.23,
    containers >=0.8 && <0.9,
    microcfta,
    text >=2.1 && <2.2,
