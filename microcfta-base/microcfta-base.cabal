cabal-version: 3.0
name: microcfta-base
version: 0.1.0.0
synopsis: Terms, paths, indexes, and ranks shared by the microcfta packages
description:
  Concrete terms and child-index paths; the newtypes of zero-based indexes,
  ranks, counts, sizes, and weights, and the mixed-radix arithmetic of ranks
  in products and groups; the tree searches over rows of alternatives; and a
  persistent union-find.

homepage: https://github.com/Tritlo/microecta/tree/main/microcfta-base#readme
bug-reports: https://github.com/Tritlo/microecta/issues
category: Data
author: Jimmy Koppel, Matthias Pall Gissurarson
maintainer: mpg@mpg.is
copyright: 2021-2024 Jimmy Koppel, 2026 Matthias Pall Gissurarson
license: BSD-3-Clause
license-file: LICENSE
build-type: Simple
tested-with: ghc ==9.14.1
extra-doc-files:
  CHANGELOG.md

source-repository head
  type: git
  location: https://github.com/Tritlo/microecta.git
  subdir: microcfta-base

common warnings
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wpartial-fields
    -Wredundant-constraints
    -Wno-pattern-namespace-specifier

common extensions
  default-language: Haskell2010
  default-extensions:
    BangPatterns
    ConstraintKinds
    DataKinds
    DefaultSignatures
    DeriveDataTypeable
    DeriveGeneric
    EmptyDataDecls
    ExistentialQuantification
    FlexibleContexts
    FlexibleInstances
    FunctionalDependencies
    GADTs
    GeneralizedNewtypeDeriving
    KindSignatures
    LambdaCase
    MultiParamTypeClasses
    MultiWayIf
    NamedFieldPuns
    PatternGuards
    PatternSynonyms
    RankNTypes
    ScopedTypeVariables
    StandaloneDeriving
    TupleSections
    TypeApplications
    TypeFamilies
    TypeOperators
    ViewPatterns

library
  import: warnings, extensions
  hs-source-dirs: src
  exposed-modules:
    Data.CFTA.Index
    Data.CFTA.Internal.Tree
    Data.CFTA.Internal.UnionFind
    Data.CFTA.Path
    Data.CFTA.Term

  build-depends:
    base >=4.22 && <4.23,
    containers >=0.8 && <0.9,
    hashable >=1.5 && <1.6,
    mtl >=2.3 && <2.4,
    transformers >=0.6 && <0.7,
    unordered-containers >=0.2 && <0.3,

test-suite base-tests
  import: warnings, extensions
  type: exitcode-stdio-1.0
  main-is: Spec.hs
  hs-source-dirs: test
  ghc-options:
    -rtsopts
    -Wno-orphans

  other-modules:
    Data.CFTA.IndexSpec
    Data.CFTA.Internal.TreeSpec
    Data.CFTA.Internal.UnionFindSpec
    Data.CFTA.TermSpec

  build-depends:
    base,
    containers >=0.8 && <0.9,
    equivalence >=0.4.1 && <0.5,
    hashable >=1.5 && <1.6,
    hspec >=2.11 && <2.12,
    microcfta-base,
    mtl >=2.3 && <2.4,
    QuickCheck >=2.14 && <2.19,
