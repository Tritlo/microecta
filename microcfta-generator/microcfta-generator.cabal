cabal-version: 3.0
name: microcfta-generator
version: 0.1.0.0
synopsis: Generators, ranking, and QuickCheck integration for constrained tree automata
description:
  Ranked enumeration, random generation, shrinking, and QuickCheck
  integration for the automata of microcfta: ordinary, equality-constrained,
  and refinement-constrained.

homepage: https://github.com/Tritlo/microecta/tree/main/microcfta-generator#readme
bug-reports: https://github.com/Tritlo/microecta/issues
category: Testing
author: Matthias Pall Gissurarson
maintainer: mpg@mpg.is
copyright: 2026 Matthias Pall Gissurarson
license: BSD-3-Clause
license-file: LICENSE
build-type: Simple
tested-with: ghc ==9.14.1
extra-doc-files:
  CHANGELOG.md
  README.md

source-repository head
  type: git
  location: https://github.com/Tritlo/microecta.git
  subdir: microcfta-generator

common warnings
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wpartial-fields
    -Wredundant-constraints
    -Wno-pattern-namespace-specifier

common extensions
  default-language: Haskell2010
  default-extensions:
    BangPatterns
    ConstraintKinds
    DataKinds
    DefaultSignatures
    DeriveDataTypeable
    DeriveGeneric
    EmptyDataDecls
    ExistentialQuantification
    FlexibleContexts
    FlexibleInstances
    FunctionalDependencies
    GADTs
    GeneralizedNewtypeDeriving
    KindSignatures
    LambdaCase
    MultiParamTypeClasses
    NamedFieldPuns
    PatternGuards
    RankNTypes
    ScopedTypeVariables
    StandaloneDeriving
    TupleSections
    TypeApplications
    TypeFamilies
    TypeOperators
    ViewPatterns

library
  import: warnings, extensions
  hs-source-dirs: src
  exposed-modules:
    Data.CFTA.Gen
    Data.CFTA.Gen.Do
    Data.CFTA.Gen.Error
    Data.CFTA.Gen.Internal.Automaton
    Data.CFTA.Gen.Internal.Bucket
    Data.CFTA.Gen.Internal.Chain
    Data.CFTA.Gen.Internal.Flat
    Data.CFTA.Gen.Internal.Grouped
    Data.CFTA.Gen.Internal.Inspect
    Data.CFTA.Gen.Internal.Inspection
    Data.CFTA.Gen.Internal.Join
    Data.CFTA.Gen.Internal.Recursion
    Data.CFTA.Gen.Internal.Recursive
    Data.CFTA.Gen.Internal.Static
    Data.CFTA.Gen.Internal.Support
    Data.CFTA.Gen.Internal.Symbolic
    Data.CFTA.Gen.Internal.Table
    Data.CFTA.Gen.Internal.Types
    Data.CFTA.Gen.Label
    Data.CFTA.Gen.QuickCheck
    Data.CFTA.Gen.Sig
    Data.CFTA.Ranked
    Data.CFTA.Ranked.Internal
    Data.CFTA.Ranked.Internal.Decoder
    Data.CFTA.Ranked.Internal.Sampler
    Data.CFTA.Ranked.Internal.Shrink
    Data.CFTA.Ranked.Internal.Size
    Data.CFTA.Ranked.QuickCheck

  build-depends:
    array >=0.5 && <0.6,
    base >=4.22 && <4.23,
    containers >=0.8 && <0.9,
    hashable >=1.5 && <1.6,
    microcfta >=0.1.0.0 && <0.2,
    mtl >=2.3 && <2.4,
    QuickCheck >=2.14 && <2.19,
    text >=2.1 && <2.2,

executable cfta-pairs
  import: warnings
  main-is: FinitePairs.hs
  hs-source-dirs: examples
  default-language: Haskell2010
  build-depends:
    base >=4.22 && <4.23,
    containers >=0.8 && <0.9,
    microcfta >=0.1.0.0 && <0.2,
    microcfta-generator,
    QuickCheck >=2.14 && <2.19,

test-suite gen-tests
  import: warnings, extensions
  type: exitcode-stdio-1.0
  main-is: GenTests.hs
  hs-source-dirs:
    common
    test

  default-extensions: PartialTypeSignatures
  ghc-options:
    -threaded
    -rtsopts
    -with-rtsopts=-N
    -Wno-partial-type-signatures

  other-modules:
    Data.CFTA.Gen.UntypedExpressionLanguage
    Data.CFTA.GenSpec
    Data.CFTA.RankedSpec

  build-depends:
    base >=4.22 && <4.23,
    containers >=0.8 && <0.9,
    hashable >=1.5 && <1.6,
    hspec >=2.11 && <2.12,
    microcfta >=0.1.0.0 && <0.2,
    microcfta-generator,
    QuickCheck >=2.14 && <2.19,
    text >=2.1 && <2.2,

benchmark untyped-expression-speed
  import: warnings, extensions
  type: exitcode-stdio-1.0
  main-is: UntypedExpressionSpeed.hs
  hs-source-dirs:
    benchmarks
    common

  ghc-options:
    -rtsopts
    -with-rtsopts=-T

  other-modules:
    Data.CFTA.Gen.UntypedExpressionLanguage
    GeneratorSpeedHarness

  build-depends:
    base >=4.22 && <4.23,
    containers >=0.8 && <0.9,
    microcfta >=0.1.0.0 && <0.2,
    microcfta-generator,
    process >=1.6 && <1.7,
    QuickCheck >=2.14 && <2.19,
    random >=1.2 && <1.4,
