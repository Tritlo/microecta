cabal-version: 3.0
name: microlta-generator
version: 0.1.0.0
synopsis: Finite generators backed by liquid tree automata
description:
  Qualified-do LTA generators with refinement-aware frozen pools, semantic
  pruning and shrinking, core-backed pool minimisation, bounded recursion, and
  exact replay.

homepage: https://github.com/Tritlo/microecta#readme
bug-reports: https://github.com/Tritlo/microecta/issues
category: Testing
author: Matthias Pall Gissurarson
maintainer: mpg@mpg.is
copyright: 2026 Matthias Pall Gissurarson
license: BSD-3-Clause
license-file: LICENSE
build-type: Simple
tested-with: ghc ==9.12.2 || ==9.14.1
extra-doc-files:
  CHANGELOG.md
  README.md

source-repository head
  type: git
  location: https://github.com/Tritlo/microecta.git
  subdir: microlta-generator

common warnings
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wpartial-fields
    -Wredundant-constraints

  if impl(ghc >=9.14)
    ghc-options: -Wno-pattern-namespace-specifier

library
  import: warnings
  hs-source-dirs: src
  default-language: Haskell2010
  default-extensions:
    NamedFieldPuns

  exposed-modules:
    Data.LTA.Gen
    Data.LTA.Gen.Do
    Data.LTA.Gen.QuickCheck

  other-modules:
    Data.LTA.Gen.Internal.AutomatonCompile
    Data.LTA.Gen.Internal.AutomatonSource
    Data.LTA.Gen.Internal.Bounded
    Data.LTA.Gen.Internal.Compile
    Data.LTA.Gen.Internal.Error
    Data.LTA.Gen.Internal.IndexedGroup
    Data.LTA.Gen.Internal.Recipe
    Data.LTA.Gen.Internal.Relational
    Data.LTA.Gen.Internal.Replay
    Data.LTA.Gen.Internal.ShrinkSearch
    Data.LTA.Gen.Internal.SourceIndex
    Data.LTA.Gen.Internal.Surface
    Data.LTA.Gen.Internal.Types
    Data.LTA.Gen.Internal.Witness

  build-depends:
    base >=4.21 && <5,
    containers >=0.7 && <0.9,
    microecta >=0.2.0.0 && <0.3,
    microecta-generator:{internal, microecta-generator} >=0.1 && <0.2,
    microfta >=0.1.0.0 && <0.2,
    microfta-generator:{internal, microfta-generator} >=0.1.0.0 && <0.2,
    microlta >=0.1 && <0.2,
    QuickCheck >=2.14 && <2.19,
    text >=2.1 && <2.2,

executable liquid-pairs
  import: warnings
  main-is: LiquidPairs.hs
  hs-source-dirs: examples
  default-language: Haskell2010
  default-extensions: OverloadedStrings
  build-depends:
    base >=4.21 && <5,
    liquid-fixpoint >=0.9.6.3.7 && <0.10,
    microecta-generator >=0.1 && <0.2,
    microlta >=0.1 && <0.2,
    microlta-generator,
    QuickCheck >=2.14 && <2.19,

executable lta-safe-division
  import: warnings
  main-is: SafeDivision.hs
  hs-source-dirs: examples
  default-language: Haskell2010
  build-depends:
    base >=4.21 && <5,
    microlta >=0.1 && <0.2,
    microlta-generator,
    QuickCheck >=2.14 && <2.19,

executable lta-automaton-interop
  import: warnings
  main-is: AutomatonInterop.hs
  hs-source-dirs: examples
  default-language: Haskell2010
  build-depends:
    base >=4.21 && <5,
    microfta >=0.1.0.0 && <0.2,
    microlta >=0.1 && <0.2,
    microlta-generator,
    QuickCheck >=2.14 && <2.19,

test-suite unit-tests
  import: warnings
  type: exitcode-stdio-1.0
  main-is: Spec.hs
  hs-source-dirs:
    common
    test

  default-language: Haskell2010
  default-extensions:
    ApplicativeDo
    NamedFieldPuns
    OverloadedStrings
    PatternSynonyms
    QualifiedDo

  other-modules:
    Data.LTA.BoundedGeneratorSpec
    Data.LTA.DependentApplicationSpec
    Data.LTA.ExampleSupport
    Data.LTA.OpaquePoolSpec
    Data.LTA.PreconditionTypedExpressionSpec
    Data.LTA.QuickCheckSyntaxSpec
    Data.LTA.RecursiveGeneratorSpec
    Data.LTA.SafeBufferLanguage
    Data.LTA.SafeBufferSpec
    Data.LTA.SimilarityMinimizationSpec
    Data.LTA.SizedVectorLanguage
    Data.LTA.SizedVectorSpec
    Data.LTA.StateMachineTraceLanguage
    Data.LTA.StateMachineTraceSpec
    Data.LTA.SubsumptionTypedExpressionSpec
    Data.LTA.TestSupport
    Data.LTA.TypedExpressionLanguage

  build-depends:
    base >=4.21 && <5,
    containers >=0.7 && <0.9,
    directory >=1.3 && <1.4,
    hspec >=2.11 && <2.12,
    liquid-fixpoint >=0.9.6.3.7 && <0.10,
    microecta >=0.2.0.0 && <0.3,
    microecta-generator >=0.1 && <0.2,
    microfta >=0.1.0.0 && <0.2,
    microfta-generator:{internal, microfta-generator} >=0.1.0.0 && <0.2,
    microlta >=0.1 && <0.2,
    microlta-generator,
    QuickCheck >=2.14 && <2.19,

benchmark state-machine-trace-speed
  import: warnings
  type: exitcode-stdio-1.0
  main-is: StateMachineTraceSpeed.hs
  hs-source-dirs:
    benchmarks
    common

  default-language: Haskell2010
  default-extensions:
    NamedFieldPuns

  ghc-options:
    -rtsopts
    -with-rtsopts=-T

  other-modules:
    Data.LTA.ExampleSupport
    Data.LTA.StateMachineTraceLanguage
    GeneratorSpeedHarness

  build-depends:
    base >=4.21 && <5,
    containers >=0.7 && <0.9,
    liquid-fixpoint >=0.9.6.3.7 && <0.10,
    microlta >=0.1 && <0.2,
    microlta-generator,
    process >=1.6 && <1.7,
    QuickCheck >=2.14 && <2.19,
    random >=1.2 && <1.4,

benchmark typed-expression-constraint-cost
  import: warnings
  type: exitcode-stdio-1.0
  main-is: TypedExpressionConstraintCost.hs
  hs-source-dirs:
    benchmarks
    common

  default-language: Haskell2010
  default-extensions:
    NamedFieldPuns

  ghc-options:
    -rtsopts
    -with-rtsopts=-T

  other-modules:
    Data.LTA.EqualityTypedExpressionLanguage
    GeneratorSpeedHarness

  build-depends:
    base >=4.21 && <5,
    containers >=0.7 && <0.9,
    liquid-fixpoint >=0.9.6.3.7 && <0.10,
    microecta-generator >=0.1 && <0.2,
    microlta >=0.1 && <0.2,
    microlta-generator,
    process >=1.6 && <1.7,
    QuickCheck >=2.14 && <2.19,
    random >=1.2 && <1.4,
